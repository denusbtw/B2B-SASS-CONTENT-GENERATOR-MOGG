INTEGRATION_MODE=mock
DATABASE_URL=postgresql+psycopg://factory:REPLACE_ME@127.0.0.1:55432/factory
POSTGRES_PASSWORD=REPLACE_ME
OPERATOR_TOKEN=REPLACE_ME
WORKER_AUTH_TOKEN=REPLACE_ME
WORKER_API_URL=http://127.0.0.1:8080
MOCK_STORAGE_ROOT=data/shared
SCRATCH_ROOT=data/scratch
REAL_POSTING_ENABLED=false

OPENAI_API_KEY=
OPENAI_STORY_MODEL=gpt-6-luna
OPENAI_TTS_MODEL=gpt-4o-mini-tts
# Real CLIPS
DRIVE_ARCHIVE_ENABLED=false
CLIPS_MAX_SOURCE_BYTES=2147483648
ARTIFACT_MAX_BYTES=2147483648
CLIPS_MAX_DURATION=7200
CLIPS_MIN_PART_SECONDS=1
CLIPS_MAX_CONCURRENT_UPLOADS=2
CLIPS_MAX_CONCURRENT_RENDERS=1
CLIPS_UPLOAD_TIMEOUT=1800
CLIPS_DOWNLOAD_TIMEOUT=1800
CLIPS_RENDER_TIMEOUT=3600

# Live YouTube is disabled by default. Drive credentials do not grant upload access.
PUBLISHER_PROVIDER=mock
YOUTUBE_ENABLED=false
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_CLIENT_FILE=
YOUTUBE_REDIRECT_URI=http://127.0.0.1:8080/api/v1/integrations/youtube/callback
YOUTUBE_TOKEN_ENCRYPTION_KEY=
YOUTUBE_TOKEN_ENCRYPTION_KEY_FILE=
# Compose only: external directory containing OAuth client/key files, mounted read-only.
YOUTUBE_SECRETS_DIR=./data/youtube-secrets
YOUTUBE_UPLOAD_CHUNK_BYTES=8388608
YOUTUBE_REQUEST_TIMEOUT=35
YOUTUBE_MAX_ATTEMPTS=8
YOUTUBE_STATUS_POLL_SECONDS=300
